            },
            "url": {
              "raw": "{{baseUrl}}/doctors/{{doctorId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "{{doctorId}}", ""]
            },
            "description": "Update a doctor's details.\n\nExpected: 200 OK"
          },
          "response": []
        },
        {
          "name": "3.5 Delete Doctor",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/doctors/{{doctorId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["doctors", "{{doctorId}}", ""]
            },
            "description": "Delete a doctor and all associated mappings.\n\nExpected: 204 No Content"
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Patient-Doctor Mappings",
      "description": "Assign and manage patient-doctor relationships. All endpoints require authentication.",
      "item": [
        {
          "name": "4.1 Create Mapping",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('mappingId', jsonData.data.id);",
                  "    console.log('Mapping ID saved: ' + jsonData.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": {{patientId}},\n  \"doctorId\": {{doctorId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/mappings/",
              "host": ["{{baseUrl}}"],
              "path": ["mappings", ""]
            },
            "description": "Assign a doctor to a patient. The patient must belong to the authenticated user.\n\nExpected: 201 Created"
          },
          "response": []
        },
        {
          "name": "4.2 Create Mapping - Duplicate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": {{patientId}},\n  \"doctorId\": {{doctorId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/mappings/",
              "host": ["{{baseUrl}}"],
              "path": ["mappings", ""]
            },
            "description": "Attempt to create a duplicate mapping.\n\nExpected: 409 Conflict"
          },
          "response": []
        },
        {
          "name": "4.3 Get All Mappings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mappings/",
              "host": ["{{baseUrl}}"],
              "path": ["mappings", ""]
            },
            "description": "Get all mappings for the authenticated user's patients.\n\nExpected: 200 OK"
          },
          "response": []
        },
        {
          "name": "4.4 Get Doctors for Patient",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mappings/{{patientId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["mappings", "{{patientId}}", ""]
            },
            "description": "Get all doctors assigned to a specific patient. The patient must belong to the authenticated user.\n\nExpected: 200 OK"
          },
          "response": []
        },
        {
          "name": "4.5 Delete Mapping",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mappings/{{mappingId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["mappings", "{{mappingId}}", ""]
            },
            "description": "Remove a patient-doctor mapping. Only the patient's owner can remove the mapping.\n\nExpected: 204 No Content"
          },
          "response": []
        }
      ]
    }
  ]
}
